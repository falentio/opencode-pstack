{
  "name": "opencode-pstack",
  "version": "0.1.0",
  "description": "OpenCode port of pstack, the rigorous agent workflow skills from Cursor.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "keywords": [
    "pstack",
    "poteto-mode",
    "skills",
    "workflow",
    "agent-style",
    "subagents"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "1.18.25"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0"
}