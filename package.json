{
  "name": "@falentio/opencode-pstack",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falentio/opencode-pstack.git"
  },
  "bugs": {
    "url": "https://github.com/falentio/opencode-pstack/issues"
  },
  "homepage": "https://github.com/falentio/opencode-pstack#readme",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "description": "OpenCode port of pstack, the rigorous agent workflow skills from Cursor.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "docs",
    "!skills/poteto-mode/scripts/bun.lock",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "pstack",
    "poteto-mode",
    "skills",
    "workflow",
    "agent-style",
    "subagents"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "1.18.25"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0"
}